{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parlor-games",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",

  // Static assets are served free and unlimited on Workers, same as Pages.
  //
  // run_worker_first is REQUIRED: by default the asset manifest is consulted
  // *before* the Worker, so /ws and /api/* would be answered with a 404 (or
  // the SPA fallback) and the Worker would never run. No error, just silence.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },

  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },

  // new_sqlite_classes, NOT new_classes. The SQLite backend is the only one
  // available on the Workers Free plan, and key-value-backed namespaces can
  // no longer be created at all.
  //
  // Using the legacy `migrations` array rather than the newer `exports` field
  // deliberately: `exports` is a one-way door (you cannot migrate back) and it
  // disables `wrangler versions upload`, gradual deployments, and rollbacks
  // across lifecycle changes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],

  "observability": { "enabled": true },
  "workers_dev": true
}
